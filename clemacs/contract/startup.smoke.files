# clemacs startup manifest (smoke)
#
# This list is data and should grow monotonically. It is the clemacs-side
# equivalent of "what we load at editor startup" (eventually driven by the
# pdump bootstrap load list in admin/pdump-common.el, or a close analogue).
#
# 2026-01-03: seed with the early pdump load order (admin/pdump-common.el).
#
# NOTE: `backquote.el` must be loaded before any files that define macros using
# backquote syntax, otherwise those macro definitions can get compiled against a
# missing `backquote` macro and later misbehave at expansion time.

# pdump: debug-early, byte-run, backquote, subr, keymap, version.
lisp/emacs-lisp/debug-early.el
lisp/emacs-lisp/byte-run.el 1
lisp/emacs-lisp/backquote.el
lisp/subr.el -
lisp/keymap.el 20
lisp/version.el 2

# pdump: widget, custom, map-ynp, mule, mule-conf, env, format, bindings, window, files.
lisp/widget.el 1
lisp/custom.el 1
lisp/emacs-lisp/map-ynp.el 1
lisp/international/mule.el 4
lisp/international/mule-conf.el 200
lisp/env.el 1
lisp/format.el 2
lisp/bindings.el 1
lisp/window.el 1
lisp/files.el 1

# pdump: macroexp, pcase, cus-face, faces, regexp-opt, rx.
lisp/emacs-lisp/macroexp.el 200
lisp/emacs-lisp/pcase.el 200
lisp/cus-face.el 1
lisp/faces.el 1
lisp/emacs-lisp/regexp-opt.el 1
lisp/emacs-lisp/rx.el 1

# pdump: autoloads snapshot (checked in; do not require make-generated loaddefs).
lisp/ldefs-boot.el 203

# pdump: button, gv, cl-lib, cl-macs, cl-preloaded, oclosure, cl-seq, seq.
lisp/button.el 1
lisp/emacs-lisp/gv.el -
lisp/emacs-lisp/cl-lib.el 10
lisp/emacs-lisp/cl-macs.el 10
lisp/emacs-lisp/cl-preloaded.el -
lisp/emacs-lisp/oclosure.el -
lisp/emacs-lisp/cl-seq.el 1
lisp/emacs-lisp/seq.el 1

# pdump: obarray, abbrev, help, jka-cmpr-hook, epa-hook, mule-util, case-table.
lisp/obarray.el 1
lisp/abbrev.el 1
lisp/help.el 1
lisp/jka-cmpr-hook.el 1
lisp/epa-hook.el 1
lisp/international/mule-util.el 1
lisp/case-table.el 1

# pdump: mule-cmds, charprop, characters.
lisp/international/mule-cmds.el 6
lisp/international/charprop.el -
lisp/international/characters.el 20

# pdump: legacy encodings (intentionally skipped; UTF-8 only; see lisp.allowed-skip.files).
lisp/international/cp51932.el 1
lisp/international/eucjp-ms.el 1

# pdump: composite, indent.
lisp/composite.el 1
lisp/indent.el -

# pdump: cl-generic.
lisp/emacs-lisp/cl-generic.el -

# pdump: simple.
lisp/simple.el -

# pdump: loaddefs (covered by ldefs-boot).
# NOTE: We intentionally do not load both `lisp/loaddefs.el` and
# `lisp/ldefs-boot.el` here since they are identical in content.

# bring-up: nadvice/minibuffer (first slice; caps will rise over time).
lisp/emacs-lisp/nadvice.el 20
lisp/minibuffer.el 20

# bring-up: frame/startup (first slice; caps will rise over time).
lisp/frame.el 1
lisp/startup.el 1
lisp/term/tty-colors.el 1
lisp/font-core.el 1
