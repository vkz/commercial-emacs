# clemacs startup manifest (smoke)
#
# This list is data and should grow monotonically. It is the clemacs-side
# equivalent of "what we load at editor startup" (eventually driven by the
# pdump bootstrap load list in admin/pdump-common.el, or a close analogue).
#
# 2026-01-03: seed with the current subr.el bootstrap checkpoint.

lisp/subr.el 340
lisp/emacs-lisp/backquote.el
lisp/version.el 2
# 2026-01-03: pdump candidate; should be dependency-free (errors only on use).
lisp/emacs-lisp/debug-early.el

# 2026-01-03: pdump candidate; start with a 1-form checkpoint (defines function-put).
lisp/emacs-lisp/byte-run.el 1

# 2026-01-03: pdump candidate; start with a 1-form checkpoint (defines keymap--check).
lisp/keymap.el 1

# 2026-01-03: pdump candidate; start with a 1-form checkpoint (defines define-widget-keywords).
lisp/widget.el 1

# 2026-01-03: pdump candidate; start with a 1-form checkpoint (defines read-envvar-name-history).
lisp/env.el 1

# 2026-01-03: pdump candidate; start with a 2-form checkpoint (buffer-file-format props only).
lisp/format.el 2
