# pdump: disp-table.
lisp/disp-table.el -

# pdump: ls-lisp.
lisp/ls-lisp.el -

# pdump: term/internal.
lisp/term/internal.el 50

# pdump: ucs-normalize.
lisp/international/ucs-normalize.el 1

# pdump: leim-list (noerror upstream).
lisp/leim/leim-list.el -

# bring-up: comint/shell (first slice; caps will rise over time).
lisp/comint.el 60
lisp/shell.el 80
