# clemacs startup manifest (check)
#
# 2026-01-03: same as smoke; diverges once startup grows.

# 2026-01-03: same list as smoke; diverges once startup grows.
#
# NOTE: `backquote.el` must be loaded before any files that define macros using
# backquote syntax, otherwise those macro definitions can get compiled against a
# missing `backquote` macro and later misbehave at expansion time.

# pdump: debug-early, byte-run, backquote, subr, keymap, version.
lisp/emacs-lisp/debug-early.el
lisp/emacs-lisp/byte-run.el 20
lisp/emacs-lisp/backquote.el
lisp/subr.el -
lisp/keymap.el -
lisp/version.el -

# pdump: widget, custom, map-ynp, mule, mule-conf, env, format, bindings, window, files.
lisp/widget.el 10
lisp/custom.el 10
lisp/emacs-lisp/map-ynp.el 10
lisp/international/mule.el 20
lisp/international/mule-conf.el 200
lisp/env.el 10
lisp/format.el 10
lisp/bindings.el 347
lisp/window.el 10
lisp/files.el -

# pdump: macroexp, pcase, cus-face, faces, regexp-opt, rx.
lisp/emacs-lisp/macroexp.el 60
lisp/emacs-lisp/pcase.el 200
lisp/cus-face.el 10
lisp/faces.el 10
lisp/emacs-lisp/regexp-opt.el 10
lisp/emacs-lisp/rx.el 10
lisp/emacs-lisp/pp.el 50
lisp/ldefs-boot.el 50

# pdump: loaddefs.
lisp/loaddefs.el -

# pdump: button, gv, cl-lib, cl-macs, cl-preloaded, oclosure, cl-seq, seq.
lisp/button.el 10
lisp/emacs-lisp/gv.el -
lisp/emacs-lisp/cl-lib.el 10
lisp/emacs-lisp/cl-macs.el 10
lisp/emacs-lisp/cl-preloaded.el 60
lisp/emacs-lisp/oclosure.el -
lisp/emacs-lisp/cl-seq.el 10
lisp/emacs-lisp/seq.el -

# bring-up: map.el (often required by core libs; load explicitly).
lisp/emacs-lisp/map.el 50

# pdump: obarray, abbrev, help, mule-util, case-table.
lisp/obarray.el 10
lisp/abbrev.el 10
lisp/help.el 10
lisp/international/mule-util.el 10
lisp/case-table.el 10

# pdump: jka-cmpr-hook.
lisp/jka-cmpr-hook.el 20

# pdump: epa-hook.
lisp/epa-hook.el 10

# pdump: mule-cmds.
lisp/international/mule-cmds.el 6

# pdump: charprop (Unicode char-code properties).
lisp/international/charprop.el -

# pdump: characters.
lisp/international/characters.el 20

# pdump: legacy encodings (temporarily skipped; see lisp.allowed-skip.files).
lisp/international/cp51932.el 1
lisp/international/eucjp-ms.el 1

# pdump: composite, indent.
lisp/composite.el 1
lisp/indent.el -

# pdump: cl-generic.
lisp/emacs-lisp/cl-generic.el -

# pdump: simple.
lisp/simple.el -

# pdump: nadvice.
lisp/emacs-lisp/nadvice.el -

# pdump: minibuffer.
lisp/minibuffer.el -

# pdump: frame.
lisp/frame.el -

# pdump: startup.
lisp/startup.el 1

# pdump: tty-colors.
lisp/term/tty-colors.el 50

# pdump: font-core.
lisp/font-core.el 50

# pdump: syntax.
lisp/emacs-lisp/syntax.el -

# pdump: font-lock.
lisp/font-lock.el 200

# pdump: jit-lock, mouse, timer, isearch.
lisp/jit-lock.el 200
lisp/mouse.el 1
lisp/fringe.el -
lisp/scroll-bar.el 11
lisp/select.el -
lisp/emacs-lisp/timer.el -
lisp/isearch.el 400

# pdump: easymenu, rfn-eshadow, menu-bar, tab-bar.
lisp/emacs-lisp/easymenu.el 1
lisp/rfn-eshadow.el 1
lisp/menu-bar.el 1
lisp/tab-bar.el 1

