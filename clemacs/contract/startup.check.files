lisp/register.el 50
lisp/textmodes/paragraphs.el 50
lisp/progmodes/prog-mode.el 50
lisp/emacs-lisp/lisp-mode.el 200
lisp/textmodes/text-mode.el 21

# pdump: fill, newcomment.
lisp/textmodes/fill.el -
lisp/newcomment.el -

# pdump: replace, tabulated-list, buff-menu.
lisp/replace.el 19
lisp/emacs-lisp/tabulated-list.el -
lisp/buff-menu.el -

# pdump: elisp-mode, float-sup, vc-hooks, ediff-hook, uniquify, electric, paren, shorthands.
