# clemacs startup manifest (tty-editor)
#
# This list is data and should grow monotonically.
#
# Purpose: a small, TTY-first editor startup slice used by the clemacs TTY loop
# (`mise run clemacs:tty:run`).  It aims to be "Emacs-shaped enough" for a
# usable terminal session: `find-file`, `save-buffer`, and `M-x`.

# pdump: debug-early, byte-run, backquote, subr, keymap, version.
lisp/emacs-lisp/debug-early.el
lisp/emacs-lisp/byte-run.el 1
lisp/emacs-lisp/backquote.el
lisp/subr.el -
lisp/keymap.el -
lisp/version.el -

# pdump: widget, custom, map-ynp.
lisp/widget.el 10
lisp/custom.el 120
lisp/emacs-lisp/map-ynp.el 10

# pdump: mule + startup basics (needed for file I/O + coding systems).
lisp/international/mule.el 20
lisp/international/mule-conf.el 200
lisp/international/mule-util.el 10
lisp/case-table.el 10

# core: macros/dispatch helpers that many libraries assume.
lisp/emacs-lisp/macroexp.el 200
lisp/emacs-lisp/pcase.el 200
lisp/cus-face.el 10
lisp/faces.el 10
lisp/emacs-lisp/regexp-opt.el 10
lisp/emacs-lisp/rx.el 10
lisp/emacs-lisp/pp.el 50
lisp/ldefs-boot.el 203
lisp/emacs-lisp/gv.el -
lisp/emacs-lisp/cl-lib.el 10
lisp/emacs-lisp/cl-macs.el 10
lisp/emacs-lisp/cl-preloaded.el 120
lisp/emacs-lisp/oclosure.el -
lisp/emacs-lisp/cl-seq.el 10
lisp/emacs-lisp/seq.el -
lisp/obarray.el 10

# key bindings + core commands.
lisp/loaddefs.el -
lisp/env.el 10
lisp/format.el 10
lisp/bindings.el 347
lisp/window.el -
lisp/frame.el -
lisp/button.el 10
lisp/files.el -
lisp/emacs-lisp/cl-generic.el -

# pdump: nadvice.
lisp/emacs-lisp/nadvice.el -
lisp/simple.el -
lisp/isearch.el -
lisp/replace.el -

# bring-up: abbrev/help/archives (first slice; caps will rise over time).
lisp/abbrev.el 10
lisp/help.el 10
lisp/jka-cmpr-hook.el 10
lisp/epa-hook.el 10
lisp/international/mule-cmds.el 6
lisp/international/charprop.el 10
lisp/international/characters.el 20
lisp/composite.el 10
lisp/indent.el 10
lisp/startup.el 50
lisp/term/tty-colors.el 50
lisp/font-core.el 50

# pdump: syntax, font-lock.
lisp/emacs-lisp/syntax.el -
lisp/font-lock.el 200

# pdump: jit-lock, timer.
lisp/jit-lock.el 200
lisp/mouse.el 50
lisp/fringe.el 50
lisp/scroll-bar.el 50
lisp/select.el 50
lisp/emacs-lisp/timer.el -

# bring-up: minibuffer UX helpers (TTY-first; cap will rise over time).
lisp/emacs-lisp/easymenu.el 50
lisp/rfn-eshadow.el 50

# bring-up: menu chrome (loaded by upstream pdump; keep capped).
lisp/menu-bar.el 1
lisp/tab-bar.el 1

# bring-up: core major modes (TTY/editor surfaces; first slice).
lisp/emacs-lisp/lisp.el 50
lisp/textmodes/page.el 50
lisp/register.el 50
lisp/textmodes/paragraphs.el 50
lisp/progmodes/prog-mode.el 50
lisp/emacs-lisp/lisp-mode.el 50
lisp/textmodes/text-mode.el 50

# bring-up: fill/comment/list UIs (TTY/editor surfaces; first slice).
lisp/textmodes/fill.el 50
lisp/newcomment.el 50
lisp/emacs-lisp/tabulated-list.el 50
lisp/buff-menu.el 50

# pdump: image, fontset.
lisp/image.el 50
lisp/international/fontset.el 50

# bring-up: elisp-mode (TTY/editor surfaces; first slice).
lisp/progmodes/elisp-mode.el 50

# pdump: float-sup, vc-hooks, ediff-hook, uniquify, electric, paren, shorthands.
lisp/emacs-lisp/float-sup.el 20
lisp/vc/vc-hooks.el 50
lisp/vc/ediff-hook.el 20
lisp/uniquify.el 20
lisp/electric.el 20
lisp/paren.el 50
lisp/emacs-lisp/shorthands.el 20

# pdump: eldoc, inline, cconv, cus-start, tooltip, iso-transl, rmc.
lisp/emacs-lisp/eldoc.el 50
lisp/emacs-lisp/inline.el 50
lisp/emacs-lisp/cconv.el 20
lisp/cus-start.el 1
lisp/tooltip.el 20
lisp/international/iso-transl.el 20
lisp/emacs-lisp/rmc.el 20

# bring-up: TTY display and directory listings (first slice).
lisp/disp-table.el 50
lisp/ls-lisp.el 50
lisp/term/internal.el 50
lisp/international/ucs-normalize.el 20

# bring-up: comint/shell (first slice; caps will rise over time).
lisp/comint.el 60
lisp/shell.el 80

# bring-up: minibuffer (first slice; caps will rise over time).
lisp/minibuffer.el 40
