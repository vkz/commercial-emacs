# Extra upstream ELisp files to load for the clemacs upstream ERT bring-up gate.
#
# One entry per line:
#   <repo-relative-path> [<max-forms>|-]
#
# Keep this list monotonic: add entries, don't delete to "get green".

# 2026-01-08: Bring up `subr-x` (string helpers + threading macros).
# NOTE(2026-01-08): In this fork, `subr-x.el` lives under `lisp/emacs-lisp/`.
# Keep the old path commented for archeology.
# lisp/subr-x.el -
lisp/emacs-lisp/subr-x.el -
test/lisp/emacs-lisp/subr-x-tests.el -

# 2026-01-11: Bring up backquote tests (startup-adjacent; pdump prelude).
test/lisp/emacs-lisp/backquote-tests.el -

# 2026-01-08: Bring up `rx` + `seq` upstream tests.
lisp/emacs-lisp/regexp-opt.el -
lisp/emacs-lisp/rx.el -
test/lisp/emacs-lisp/rx-tests.el -
lisp/emacs-lisp/seq.el -
test/lisp/emacs-lisp/seq-tests.el -

# 2026-01-08: Bring up `kbd` parsing tests.
test/lisp/subr-tests.el -

# 2026-01-08: Bring up keymap helpers for subr-tests keymap cluster.
lisp/keymap.el -

# 2026-01-10: Bring up `help-command` binding in `global-map` (subr-tests).
lisp/help.el 50

# 2026-01-08: Bring up `pcase` + `map` tests.
# NOTE: `cl-lib.el` assumes `gv` is already available (as in upstream Emacs
# preload).  Load macroexp/gv first for clemacs bring-up.
lisp/emacs-lisp/macroexp.el -
lisp/emacs-lisp/gv.el -
lisp/emacs-lisp/cl-lib.el -
lisp/emacs-lisp/pcase.el -
test/lisp/emacs-lisp/pcase-tests.el -
lisp/version.el -
lisp/emacs-lisp/map.el -
test/lisp/emacs-lisp/map-tests.el -

# 2026-01-08: Bring up `cl-lib` upstream tests.
lisp/emacs-lisp/cl-seq.el -
test/lisp/emacs-lisp/cl-lib-tests.el -

# 2026-01-10: Prereqs for `cl-generic`/`nadvice` bring-up (startup-adjacent).
# NOTE: `cl-macs.el` is compile-time heavy; cap it to avoid deep `define-inline`
# fallout during upstream ERT bring-up.
lisp/emacs-lisp/cl-macs.el 10
lisp/emacs-lisp/cl-preloaded.el -
lisp/emacs-lisp/oclosure.el -

# 2026-01-10: Bring up `cl-generic` upstream tests.
lisp/emacs-lisp/cl-generic.el -
test/lisp/emacs-lisp/cl-generic-tests.el -

# 2026-01-10: Bring up `nadvice` upstream tests (advice system).
lisp/emacs-lisp/cl-print.el -
lisp/emacs-lisp/nadvice.el -
lisp/emacs-lisp/advice.el -
test/lisp/emacs-lisp/nadvice-tests.el -
