#!/usr/bin/env bash
set -euo pipefail

#MISE description="Guardrails: ensure removed ports/features stay removed"
#USAGE flag "-h --help" help="Print help"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

fail() {
  echo "[trim:check] $*" >&2
  exit 1
}

for dir in nextstep lwlib oldXMenu; do
  if [[ -e "${dir}" ]]; then
    fail "unexpected path still present: ${dir}"
  fi
done
if [[ -e "admin/unidata" ]]; then
  fail "unexpected path still present: admin/unidata"
fi
for path in modules src/emacs-module.c test/src/emacs-module-tests.el test/src/emacs-module-resources; do
  if [[ -e "${path}" ]]; then
    fail "unexpected path still present: ${path}"
  fi
done
for path in admin/notes admin/gitmerge.el admin/make-manuals admin/make-emacs admin/merge-gnulib; do
  if [[ -e "${path}" ]]; then
    fail "unexpected path still present: ${path}"
  fi
done
for path in \
  src/emacsgtkfixed.c src/emacsgtkfixed.h \
  src/gtkutil.c src/gtkutil.h \
  src/pgtkim.c src/pgtkgui.h src/pgtkterm.h \
  src/nsgui.h src/nsfns.m src/nsfont.m src/nsimage.m src/nsmenu.m src/nsselect.m \
  src/nsterm.h src/nsterm.m src/nsxwidget.h src/nsxwidget.m \
  src/macfont.h src/macfont.m \
  src/xfns.c src/xfont.c src/xftfont.c src/xgselect.c src/xgselect.h \
  src/xmenu.c src/xrdb.c src/xselect.c src/xsettings.c src/xsettings.h \
  src/xsmfns.c src/xterm.c src/xterm.h src/xwidget.c src/widget.c src/w16select.c \
  src/pgtkterm.h; do
  if [[ -e "${path}" ]]; then
    fail "unexpected path still present: ${path}"
  fi
done

if [[ -d "info" ]] && find info -maxdepth 1 -type f -iname '*w32*' | rg -n . >/dev/null; then
  fail "unexpected Windows-only Info files still present under info/"
fi

if rg -n --fixed-strings -- "--with-native-compilation" configure.ac Makefile.in >/dev/null; then
  fail "found native-comp build/config references"
fi
if rg -n --fixed-strings -- "AC_CHECK_LIB([gccjit]" configure.ac >/dev/null; then
  fail "found gccjit probing in configure.ac"
fi
if rg -n --fixed-strings -- "libgccjit.h" configure.ac src >/dev/null; then
  fail "found libgccjit.h references in build/runtime code"
fi
if rg -n --fixed-strings -- "gcc_jit_" configure.ac src >/dev/null; then
  fail "found gcc_jit_ symbol usage in build/runtime code"
fi
if rg -n --fixed-strings -- "emacs-module.h" Makefile.in >/dev/null; then
  fail "found emacs-module.h references in top-level build rules"
fi

for path in \
  lisp/term/common-win.el lisp/term/x-win.el lisp/term/ns-win.el lisp/term/pgtk-win.el \
  lisp/x-dnd.el lisp/pgtk-dnd.el \
  test/lisp/x-dnd-tests.el; do
  if [[ -e "${path}" ]]; then
    fail "unexpected GUI-only Elisp still present: ${path}"
  fi
done

if [[ -f "lisp/ldefs-boot.el" ]] && rg -n --fixed-strings -- "Generated autoloads from pgtk-dnd.el" lisp/ldefs-boot.el >/dev/null; then
  fail "found stale ldefs-boot for removed pgtk-dnd.el"
fi
if [[ -f "lisp/loaddefs.el" ]] && rg -n --fixed-strings -- "Generated autoloads from pgtk-dnd.el" lisp/loaddefs.el >/dev/null; then
  fail "found stale loaddefs for removed pgtk-dnd.el"
fi
if [[ -f "lisp/loaddefs.el" ]] && rg -n --fixed-strings -- "Generated autoloads from x-dnd.el" lisp/loaddefs.el >/dev/null; then
  fail "found stale loaddefs for removed x-dnd.el"
fi

echo "[trim:check] OK"
