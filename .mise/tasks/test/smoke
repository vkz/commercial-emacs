#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run a fast, engine-focused ERT smoke suite"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree build directory" default="build/macos-tty"
#USAGE flag "-j --jobs <n>" help="make -j jobs (default: cpu count)" default=""
#USAGE flag "-f --force" help="Force rebuilding test logs (pass -B to make)"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"

if [[ ! -x "${build_dir}/src/emacs" ]]; then
  mise run build -- --build-dir "${build_dir}"
fi

test_dir="${build_dir}/test"
if [[ ! -f "${test_dir}/Makefile" ]]; then
  echo "[test:smoke] missing ${test_dir}/Makefile; did configure succeed?" >&2
  exit 1
fi

jobs="${usage_jobs:-}"
if [[ -z "${jobs}" ]]; then
  jobs="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)"
fi

targets=(
  # Populated below from test/contract/smoke.logtargets
)

contract_file="${project_root}/test/contract/smoke.logtargets"
if [[ ! -f "${contract_file}" ]]; then
  echo "[test:smoke] missing ${contract_file}; did you remove test/contract/?" >&2
  exit 1
fi

targets=()
while IFS= read -r line; do
  case "${line}" in
    ""|\#*) continue ;;
  esac
  targets+=("${line}")
done < "${contract_file}"

if [[ "${#targets[@]}" -eq 0 ]]; then
  echo "[test:smoke] empty contract: ${contract_file}" >&2
  exit 1
fi

echo "[test:smoke] running ${#targets[@]} targets (-j${jobs})"
if [[ "${usage_force:-false}" == "true" ]]; then
  make -C "${test_dir}" -B -j"${jobs}" "${targets[@]}"
else
  make -C "${test_dir}" -j"${jobs}" "${targets[@]}"
fi
