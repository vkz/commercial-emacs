#!/usr/bin/env bash
set -euo pipefail

#MISE description="Build Info manuals (opt-in; does not update info/dir)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree build directory" default="build/macos-tty"
#USAGE flag "-j --jobs <n>" help="make -j jobs (default: cpu count)" default=""
#USAGE flag "-f --force" help="Force rebuilding docs (pass -B to make)"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
if [[ ! -f "${build_dir}/Makefile" ]]; then
  mise run configure:tty -- --build-dir "${build_dir}"
fi

jobs="${usage_jobs:-}"
if [[ -z "${jobs}" ]]; then
  jobs="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)"
fi

make_flags=("-j${jobs}")
if [[ "${usage_force:-false}" == "true" ]]; then
  make_flags+=("-B")
fi

if ! command -v texi2any >/dev/null 2>&1 && ! command -v makeinfo >/dev/null 2>&1; then
  echo "[docs:info] missing texinfo tools (need texi2any or makeinfo)" >&2
  exit 1
fi

echo "[docs:info] building Info manuals in ${build_dir}"
make -C "${build_dir}" "${make_flags[@]}" emacs-info lispref-info lispintro-info misc-info
