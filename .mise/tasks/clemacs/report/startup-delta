#!/usr/bin/env bash
set -euo pipefail

#MISE description="Report startup manifest vs admin/pdump-common.el (experimental)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"
#USAGE flag "--out-dir <dir>" help="Output directory for report artifacts" default=""
#USAGE flag "--report <path>" help="Markdown report path" default=""
#USAGE flag "--manifest <path>" help="Manifest file to compare against pdump load list" default="clemacs/contract/startup.smoke.files"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"

out_dir="${usage_out_dir:-}"
if [[ -z "${out_dir}" ]]; then
  out_dir="${project_root}/${build_dir}/reports"
fi
mkdir -p "${out_dir}"

report_path="${usage_report:-}"
if [[ -z "${report_path}" ]]; then
  report_path="${out_dir}/startup-delta.md"
fi

export CLEMACS_REPORT_BUILD_DIR="${build_dir}"
export CLEMACS_REPORT_OUT_DIR="${out_dir}"
export CLEMACS_REPORT_PATH="${report_path}"
export CLEMACS_REPORT_MANIFEST="${usage_manifest}"

python3 - <<'PY'
import os
import re
from pathlib import Path

project_root = Path(os.environ.get("MISE_PROJECT_ROOT") or os.getcwd())
build_dir = Path(os.environ.get("CLEMACS_REPORT_BUILD_DIR") or "build/clemacs")
out_dir = Path(os.environ.get("CLEMACS_REPORT_OUT_DIR") or (project_root / build_dir / "reports"))
report_path = Path(os.environ.get("CLEMACS_REPORT_PATH") or (out_dir / "startup-delta.md"))
manifest_rel = os.environ.get("CLEMACS_REPORT_MANIFEST") or "clemacs/contract/startup.smoke.files"

pdump = project_root / "admin" / "pdump-common.el"
manifest_path = project_root / manifest_rel
lisp_root = project_root / "lisp"

def read_manifest(path: Path):
    out = []
    if not path.exists():
        return out
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        out.append(line.split()[0])
    return out

def _ensure_el_suffix(path: str) -> str:
    return path if path.endswith(".el") else f"{path}.el"

def resolve_pdump_load(name: str) -> str:
    """
    Resolve a (load "NAME") entry in admin/pdump-common.el to a concrete repo
    path under lisp/.

    This is intentionally best-effort and deterministic; it exists to produce
    an actionable candidate list for updating startup manifests.
    """
    # Explicit subdirs in pdump-common.el (e.g. "emacs-lisp/macroexp").
    if "/" in name:
        rel = name[5:] if name.startswith("lisp/") else f"lisp/{name}"
        return _ensure_el_suffix(rel)

    # For bare names, emulate load-path resolution by searching lisp/**.
    base = name[:-3] if name.endswith(".el") else name
    preferred = [
        lisp_root / f"{base}.el",
        lisp_root / "emacs-lisp" / f"{base}.el",
    ]
    for p in preferred:
        if p.exists():
            return p.relative_to(project_root).as_posix()

    matches = sorted(lisp_root.rglob(f"{base}.el"))
    if len(matches) == 1:
        return matches[0].relative_to(project_root).as_posix()
    if matches:
        # Deterministic fallback for ambiguous names.
        return matches[0].relative_to(project_root).as_posix()

    # As a last resort, keep the previous behavior.
    return f"lisp/{base}.el"

startup = read_manifest(manifest_path)
startup_set = set(startup)

text = pdump.read_text(encoding="utf-8")
# Match forms like: (load "foo") or (load "foo" t)
loads = re.findall(r'\(load\s+"([^"]+)"', text)

pdump_paths_all = []
for name in loads:
    pdump_paths_all.append(resolve_pdump_load(name))

missing_in_repo = [p for p in pdump_paths_all if not (project_root / p).exists()]
existing = [p for p in pdump_paths_all if (project_root / p).exists()]

def ordered_unique(items):
    seen = set()
    out = []
    for item in items:
        if item in seen:
            continue
        seen.add(item)
        out.append(item)
    return out

existing_unique = ordered_unique(existing)
missing_unique = [p for p in existing_unique if p not in startup_set]
present_unique = [p for p in existing_unique if p in startup_set]

out_dir.mkdir(parents=True, exist_ok=True)

def md_list(items, limit=30):
    if not items:
        return ["- (none)"]
    out = []
    for i, item in enumerate(items[:limit], start=1):
        out.append(f"- {item}")
    if len(items) > limit:
        out.append(f"- ... ({len(items) - limit} more)")
    return out

lines = []
lines.append("# clemacs startup delta report")
lines.append("")
lines.append(f"- pdump source: `{pdump}`")
lines.append(f"- startup manifest: `{manifest_path}`")
lines.append("")
lines.append("## Summary")
lines.append(f"- pdump load entries: {len(pdump_paths_all)} (includes duplicates)")
lines.append(f"- pdump unique existing entries: {len(existing_unique)}")
lines.append(f"- pdump entries missing in repo: {len(set(missing_in_repo))}")
lines.append(f"- startup entries: {len(startup)}")
lines.append(f"- present in startup: {len(present_unique)}")
lines.append(f"- missing from startup: {len(missing_unique)}")
lines.append("")
lines.append("## Next candidates (pdump entries missing from startup)")
lines.extend(md_list(missing_unique, limit=40))
lines.append("")
lines.append("## Pdump entries missing in repo")
lines.extend(md_list(ordered_unique(missing_in_repo), limit=40))
lines.append("")

report_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
print(f"[clemacs:report:startup-delta] wrote {report_path}")
PY
