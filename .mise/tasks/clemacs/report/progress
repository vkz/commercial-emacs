#!/usr/bin/env bash
set -euo pipefail

#MISE description="Write a lightweight clemacs progress dashboard (startup+ERT+inventory+stamps)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
out_dir="${project_root}/${build_dir}/reports"
mkdir -p "${out_dir}"

report_path="${out_dir}/progress.md"
report_json_path="${out_dir}/progress.json"
now_utc="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
git_rev="$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"

count_noncomment_lines() {
  local path="$1"
  if [[ ! -f "${path}" ]]; then
    echo "0"
    return
  fi
  awk '
    /^[[:space:]]*#/ {next}
    /^[[:space:]]*$/ {next}
    {c++}
    END {print c+0}
  ' "${path}"
}

summarize_manifest() {
  local path="$1"
  if [[ ! -f "${path}" ]]; then
    echo "missing"
    return
  fi
  awk '
    /^[[:space:]]*#/ {next}
    /^[[:space:]]*$/ {next}
    {
      n++
      if ($2 ~ /^[0-9]+$/) { capped++; sum += $2 }
      else if ($2 == "-") { nolimit++ }
    }
    END {
      printf("entries=%d capped=%d nolimit=%d sum_maxforms=%d", n+0, capped+0, nolimit+0, sum+0)
    }
  ' "${path}"
}

render_bar() {
  local cur="$1"
  local total="$2"
  local width="${3:-24}"
  if [[ "${total}" -le 0 ]]; then
    printf "[%*s]" "${width}" ""
    return
  fi
  local filled=$(( (cur * width) / total ))
  if [[ "${filled}" -gt "${width}" ]]; then
    filled="${width}"
  fi
  local empty=$(( width - filled ))
  printf "["
  if [[ "${filled}" -gt 0 ]]; then
    printf "%0.s#" $(seq 1 "${filled}")
  fi
  if [[ "${empty}" -gt 0 ]]; then
    printf "%0.s." $(seq 1 "${empty}")
  fi
  printf "]"
}

startup_smoke="clemacs/contract/startup.smoke.files"
startup_check="clemacs/contract/startup.check.files"
startup_editor="clemacs/contract/startup.editor-core.files"
startup_tty="clemacs/contract/startup.tty-editor.files"

ert_upstream_tests="clemacs/contract/ert-upstream.tests"
ert_known_fail="clemacs/contract/ert-upstream.known-fail.tests"

ert_upstream_count="$(count_noncomment_lines "${ert_upstream_tests}")"
ert_known_fail_count="$(count_noncomment_lines "${ert_known_fail}")"

startup_smoke_summary="$(summarize_manifest "${startup_smoke}")"
startup_check_summary="$(summarize_manifest "${startup_check}")"
startup_editor_summary="$(summarize_manifest "${startup_editor}")"
startup_tty_summary="$(summarize_manifest "${startup_tty}")"

pdump_json="$(
  python3 - <<'PY'
import json
import os
import re
from pathlib import Path

project_root = Path(os.environ.get("MISE_PROJECT_ROOT") or os.getcwd())
lisp_root = project_root / "lisp"
pdump = project_root / "admin" / "pdump-common.el"
skip_path = project_root / "clemacs" / "contract" / "lisp.allowed-skip.files"

def read_manifest(path: Path):
    out = []
    if not path.exists():
        return out
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        out.append(line.split()[0])
    return out

def read_skip(path: Path):
    return set(read_manifest(path))

def _ensure_el_suffix(path: str) -> str:
    return path if path.endswith(".el") else f"{path}.el"

def resolve_pdump_load(name: str) -> str:
    if "/" in name:
        rel = name[5:] if name.startswith("lisp/") else f"lisp/{name}"
        return _ensure_el_suffix(rel)

    base = name[:-3] if name.endswith(".el") else name
    preferred = [
        lisp_root / f"{base}.el",
        lisp_root / "emacs-lisp" / f"{base}.el",
    ]
    for p in preferred:
        if p.exists():
            return p.relative_to(project_root).as_posix()

    matches = sorted(lisp_root.rglob(f"{base}.el"))
    if len(matches) == 1:
        return matches[0].relative_to(project_root).as_posix()
    if matches:
        return matches[0].relative_to(project_root).as_posix()

    return f"lisp/{base}.el"

text = pdump.read_text(encoding="utf-8")
loads = re.findall(r'\(load\s+"([^"]+)"', text)
pdump_paths_all = [resolve_pdump_load(name) for name in loads]

existing = [p for p in pdump_paths_all if (project_root / p).exists()]

seen = set()
pdump_existing_unique = []
for p in existing:
    if p in seen:
        continue
    seen.add(p)
    pdump_existing_unique.append(p)

skip_set = read_skip(skip_path)

def coverage(manifest_rel: str):
    manifest_path = project_root / manifest_rel
    startup = read_manifest(manifest_path)
    startup_set = set(startup)
    present = [p for p in pdump_existing_unique if p in startup_set or p in skip_set]
    return {
        "manifest": manifest_rel,
        "startup_entries": len(startup),
        "pdump_total": len(pdump_existing_unique),
        "pdump_present": len(present),
        "pdump_missing": len(pdump_existing_unique) - len(present),
    }

out = {
    "pdump_total": len(pdump_existing_unique),
    "check": coverage("clemacs/contract/startup.check.files"),
    "tty_editor": coverage("clemacs/contract/startup.tty-editor.files"),
}
print(json.dumps(out))
PY
)"

pdump_total="$(python3 - <<PY
import json
d=json.loads('''${pdump_json}''')
print(d.get('pdump_total', 0))
PY
)"
pdump_check_present="$(python3 - <<PY
import json
d=json.loads('''${pdump_json}''')
print(d.get('check', {}).get('pdump_present', 0))
PY
)"
pdump_tty_present="$(python3 - <<PY
import json
d=json.loads('''${pdump_json}''')
print(d.get('tty_editor', {}).get('pdump_present', 0))
PY
)"

ert_total_estimate="$(
  rg -n "^\\(ert-deftest\\s" test/lisp -g'*.el' 2>/dev/null | wc -l | tr -d ' '
)"

tty_ux_ok="0"
tty_ux_total="0"
tty_ux_contract="clemacs/contract/tty-ux.bindings.txt"
if [[ -f "${tty_ux_contract}" && -x "${project_root}/${build_dir}/bin/emacs" ]]; then
  export CLEMACS_SUBSTRATE_DYLIB="${project_root}/${build_dir}/bin/libemxsubstrate.dylib"
  tty_ux_total="$(count_noncomment_lines "${tty_ux_contract}")"
  tty_ux_out_path="${project_root}/${build_dir}/tmp/tty-ux.bindings.out"
  tty_ux_err_path="${tty_ux_out_path}.err"
  mkdir -p "$(dirname "${tty_ux_out_path}")"
  "${project_root}/${build_dir}/bin/emacs" \
    --batch \
    -Q \
    --startup-level tty-editor \
    --eval "(let ((ok 0) (total 0)) (dolist (line (split-string (with-temp-buffer (insert-file-contents \"${project_root}/${tty_ux_contract}\") (buffer-string)) \"\\\\n\" t)) (unless (or (string= line \"\") (eq (aref line 0) ?#)) (let* ((parts (split-string line \"\\\\t\")) (k (car parts)) (expect (intern (cadr parts))) (got (key-binding (kbd k) t)) (pass (eq got expect))) (setq total (1+ total)) (when pass (setq ok (1+ ok))) (princ (format \"%s\\t%s\\t%S\\n\" (if pass \"ok\" \"fail\") k got))))) (princ (format \"summary\\t%d/%d\\n\" ok total)))" \
    >"${tty_ux_out_path}" 2>"${tty_ux_err_path}" || true

  tty_ux_ok="$(
    rg -o "[0-9]+/[0-9]+" "${tty_ux_out_path}" | tail -n 1 | cut -d/ -f1 || echo 0
  )"
fi

mise run clemacs:inventory:used-startup-check -- --build-dir "${build_dir}" >/dev/null

inv_json="${project_root}/${build_dir}/tmp/inventory-used.json"
inv_line="(missing inventory-used.json)"
inv_used="0"
inv_total="0"
if [[ -f "${inv_json}" ]]; then
  inv_line="$(
    python3 - <<PY
import json
from pathlib import Path
p=Path("${inv_json}")
d=json.loads(p.read_text())
print(f"used_runtime_subrs_unique={d.get('used_runtime_subrs_unique')} runtime_subrs_total={d.get('runtime_subrs_total')} respect_maxforms={d.get('respect_maxforms')}")
PY
  )"
  inv_used="$(
    python3 - <<PY
import json
from pathlib import Path
p=Path("${inv_json}")
d=json.loads(p.read_text())
print(int(d.get("used_runtime_subrs_unique") or 0))
PY
  )"
  inv_total="$(
    python3 - <<PY
import json
from pathlib import Path
p=Path("${inv_json}")
d=json.loads(p.read_text())
print(int(d.get("runtime_subrs_total") or 0))
PY
  )"
fi

stamp_dir="${project_root}/${build_dir}/stamps"
stamp_smoke="${stamp_dir}/clemacs-contract-smoke.ok"
stamp_elisp="${stamp_dir}/clemacs-contract-elisp-core.ok"
stamp_check="${stamp_dir}/clemacs-contract-check.ok"

stamp_summary() {
  local path="$1"
  if [[ ! -f "${path}" ]]; then
    echo "missing"
    return
  fi
  awk -F= '
    $1=="status"{status=$2}
    $1=="when"{when=$2}
    $1=="git"{git=$2}
    END{
      if (status=="") status="unknown";
      if (when=="") when="unknown";
      if (git=="") git="unknown";
      printf("status=%s when=%s git=%s", status, when, git)
    }
  ' "${path}"
}

stamp_smoke_summary="$(stamp_summary "${stamp_smoke}")"
stamp_elisp_summary="$(stamp_summary "${stamp_elisp}")"
stamp_check_summary="$(stamp_summary "${stamp_check}")"

meters_json="$(
  python3 - <<PY
import json

def meter(label, current, total, bar):
    current = int(current)
    total = int(total)
    return {
        "label": label,
        "current": current,
        "total": total,
        "value": f"{current}/{total}" if total else str(current),
        "bar": bar,
    }

out = {
    "git": "${git_rev}",
    "generated": "${now_utc}",
    "build_dir": "${build_dir}",
    "meters": [
        meter("pdump.check coverage", ${pdump_check_present}, ${pdump_total}, "$(render_bar "${pdump_check_present}" "${pdump_total}")"),
        meter("pdump.tty-editor coverage", ${pdump_tty_present}, ${pdump_total}, "$(render_bar "${pdump_tty_present}" "${pdump_total}")"),
        meter("tty UX keybindings", ${tty_ux_ok}, ${tty_ux_total}, "$(render_bar "${tty_ux_ok}" "${tty_ux_total}")"),
        meter("upstream ERT must-pass", ${ert_upstream_count}, ${ert_total_estimate}, "$(render_bar "${ert_upstream_count}" "${ert_total_estimate}")"),
        meter("inventory used (subrs)", ${inv_used}, ${inv_total}, "$(render_bar "${inv_used}" "${inv_total}")"),
    ],
}
print(json.dumps(out, indent=2, sort_keys=True))
PY
)"

printf "%s\n" "${meters_json}" >"${report_json_path}"

{
  echo "# clemacs progress dashboard"
  echo
  echo "Generated: ${now_utc}"
  echo
  echo "- git: ${git_rev}"
  echo "- build-dir: \`${build_dir}\`"
  echo
  echo "## Contract stamps"
  echo
  echo "- smoke: ${stamp_smoke_summary} (\`${stamp_smoke}\`)"
  echo "- elisp-core: ${stamp_elisp_summary} (\`${stamp_elisp}\`)"
  echo "- check: ${stamp_check_summary} (\`${stamp_check}\`)"
  echo
  echo "## Startup manifests"
  echo
  echo "- \`${startup_smoke}\`: ${startup_smoke_summary}"
  echo "- \`${startup_check}\`: ${startup_check_summary}"
  echo "- \`${startup_editor}\`: ${startup_editor_summary}"
  echo "- \`${startup_tty}\`: ${startup_tty_summary}"
  echo
  echo "## Upstream ERT bring-up"
  echo
  echo "- must-pass tests: ${ert_upstream_count} (\`${ert_upstream_tests}\`)"
  echo "- total upstream tests (est): ${ert_total_estimate} (\`test/lisp/**/*.el\`)"
  echo "- known-fail tests: ${ert_known_fail_count} (\`${ert_known_fail}\`)"
  echo
  echo "## Inventory usage (checkpoint-aware)"
  echo
  echo "- ${inv_line}"
  echo "- details: \`${inv_json}\`"
  echo
  echo "## Meters (toward targets)"
  echo
  echo "| Meter | Current | Bar |"
  echo "| --- | ---: | --- |"
  echo "| pdump.check coverage | ${pdump_check_present}/${pdump_total} | \`$(render_bar "${pdump_check_present}" "${pdump_total}")\` |"
  echo "| pdump.tty-editor coverage | ${pdump_tty_present}/${pdump_total} | \`$(render_bar "${pdump_tty_present}" "${pdump_total}")\` |"
  echo "| tty UX keybindings (target list) | ${tty_ux_ok}/${tty_ux_total} | \`$(render_bar "${tty_ux_ok}" "${tty_ux_total}")\` |"
  echo "| upstream ERT must-pass size | ${ert_upstream_count}/${ert_total_estimate} | \`$(render_bar "${ert_upstream_count}" "${ert_total_estimate}")\` |"
  echo "| inventory used (subrs) | ${inv_used}/${inv_total} | \`$(render_bar "${inv_used}" "${inv_total}")\` |"
  echo
  echo "Details:"
  echo "- tty UX per-binding: \`${tty_ux_out_path}\`"
  echo "- tty UX stderr: \`${tty_ux_err_path}\`"
  echo "- meters JSON: \`${report_json_path}\`"
} >"${report_path}"

echo "[clemacs:report:progress] wrote ${report_path}"
