#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run clemacs TTY loop under a PTY (non-interactive gate)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}/tmp"

export XDG_CACHE_HOME="${project_root}/${build_dir}/xdg-cache"
export XDG_CONFIG_HOME="${project_root}/${build_dir}/xdg-config"
export XDG_DATA_HOME="${project_root}/${build_dir}/xdg-data"

home_dir="${project_root}/${build_dir}/home"
mkdir -p "${home_dir}"
export HOME="${home_dir}"

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"
usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/substrate/build"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
substrate_dylib="${project_root}/${build_dir}/substrate/libemxsubstrate.dylib"

export CLEMACS_SUBSTRATE_DYLIB="${substrate_dylib}"

export CLEMACS_TTY_TEST_QLOT_BIN="${qlot_bin}"
export CLEMACS_TTY_TEST_PROJECT_ROOT="${project_root}"
export CLEMACS_TTY_TEST_TMPDIR="${project_root}/${build_dir}/tmp"

cd "${deps_dir}"

python3 - <<'PY'
import os
import pty
import select
import sys
import tempfile
import time

project_root = os.environ.get("CLEMACS_TTY_TEST_PROJECT_ROOT") or os.getcwd()
qlot_bin = os.environ.get("CLEMACS_TTY_TEST_QLOT_BIN")
tmpdir = os.environ.get("CLEMACS_TTY_TEST_TMPDIR") or os.getcwd()
if not qlot_bin:
    raise SystemExit("missing CLEMACS_TTY_TEST_QLOT_BIN")

asd_path = os.path.join(project_root, "clemacs", "clemacs.asd")
cmd = [
    qlot_bin,
    "exec",
    "sbcl",
    "--noinform",
    "--no-sysinit",
    "--no-userinit",
    "--disable-debugger",
    "--eval",
    "(require :asdf)",
    "--eval",
    f'(asdf:load-asd #p"{asd_path}")',
    "--eval",
    "(asdf:load-system :clemacs)",
    "--eval",
    '(uiop:quit (clemacs:tty-main :path (or (uiop:getenv "CLEMACS_TTY_PATH") "")))',
]

def run_pty(*, level, tty_path, data, expect_file_bytes):
    env = dict(os.environ)
    env["CLEMACS_TTY_STARTUP_LEVEL"] = level
    env["CLEMACS_TTY_PATH"] = tty_path

    pid, fd = pty.fork()
    if pid == 0:
        os.execvpe(cmd[0], cmd, env)

    os.set_blocking(fd, False)
    deadline = time.time() + 40.0
    buf = bytearray()

    banner_deadline = time.time() + 3.0
    while time.time() < banner_deadline:
        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            try:
                chunk = os.read(fd, 4096)
                if chunk:
                    buf += chunk
            except OSError:
                pass

    try:
        # `fd` is non-blocking; `os.write` can be partial.  Avoid silently
        # dropping keystrokes (which can make the TTY loop appear to hang
        # waiting for input).
        view = memoryview(data)
        off = 0
        # Allow up to the main deadline to feed the whole keystroke stream.
        write_deadline = deadline
        while off < len(view) and time.time() < write_deadline:
            try:
                n = os.write(fd, view[off:])
                if n:
                    off += n
                    continue
            except BlockingIOError:
                pass
            except OSError:
                break
            _, w, _ = select.select([], [fd], [], 0.05)
            if not w:
                continue
        if off < len(view):
            sys.stderr.write(f"[clemacs:test:tty] WARN: short pty write: {off}/{len(view)} bytes\n")
    except OSError:
        pass

    exit_code = None
    while True:
        now = time.time()
        if now > deadline:
            os.kill(pid, 9)
            sys.stderr.write(buf.decode("utf-8", "replace"))
            raise RuntimeError("timeout waiting for clemacs tty")

        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            try:
                chunk = os.read(fd, 4096)
                if chunk:
                    buf += chunk
            except OSError:
                pass

        wpid, status = os.waitpid(pid, os.WNOHANG)
        if wpid == pid:
            if os.WIFEXITED(status):
                exit_code = os.WEXITSTATUS(status)
            elif os.WIFSIGNALED(status):
                exit_code = 128 + os.WTERMSIG(status)
            break

    if exit_code != 0:
        sys.stderr.write(buf.decode("utf-8", "replace"))
        raise SystemExit(exit_code)

    if expect_file_bytes is not None:
        if not os.path.exists(tty_path):
            sys.stderr.write(buf.decode("utf-8", "replace"))
            raise SystemExit("tty test failed: output file not written")

        content = open(tty_path, "rb").read()
        if content != expect_file_bytes:
            sys.stderr.write(buf.decode("utf-8", "replace"))
            sys.stderr.write("tty test unexpected file contents: %r\n" % (content,))
            raise SystemExit(1)
    return bytes(buf)


# 1) Bring-up gate (`subr`): minimal edit/save/quit with local keymap stubs.
fd1, outfile1 = tempfile.mkstemp(prefix="tty-test.", dir=tmpdir)
os.close(fd1)
try:
    data1 = bytearray()
    data1 += b"abc"
    data1 += bytes([27, 91, 68])  # left arrow
    data1 += b"X"
    data1 += b"\nline2"
    data1 += bytes([24, 19])  # C-x C-s (save)
    data1 += bytes([24, 3])  # C-x C-c (quit)

    run_pty(
        level="subr",
        tty_path=outfile1,
        data=bytes(data1),
        expect_file_bytes=b"abX\nline2c",
    )
finally:
    try:
        os.unlink(outfile1)
    except OSError:
        pass

# 2) Usable editor slice (`tty-editor`): C-x C-f → edit → C-x C-s → M-x quit.
fd2, outfile2 = tempfile.mkstemp(prefix="tty-test.", dir=tmpdir)
os.close(fd2)
try:
    # Start in *scratch*; visit OUTFILE via C-x C-f.
    data2 = bytearray()
    data2 += bytes([24, 6])  # C-x C-f (find-file)
    data2 += outfile2.encode("utf-8")
    data2 += b"\n"
    data2 += b"abX\nline2c"
    data2 += bytes([24, 19])  # C-x C-s (save-buffer)
    # Search/replace slice: C-r / C-s and M-% query-replace.
    data2 += bytes([18])  # C-r (isearch-backward)
    data2 += b"line2\n"
    data2 += bytes([19])  # C-s (isearch-forward)
    data2 += b"c\n"
    data2 += bytes([19])  # C-s again (repeat; may fail, should not crash)
    data2 += bytes([27, 60])  # M-< (beginning-of-buffer)
    data2 += bytes([27, 37])  # M-% (query-replace)
    data2 += b"line2\n"
    data2 += b"LINE2\n"
    # Query-replace prompts accept a single keystroke (no RET needed).
    data2 += b"y"
    data2 += bytes([24, 19])  # C-x C-s (save-buffer)
    # Minibuffer history: M-x save-buffer, then M-x M-p RET recalls it.
    data2 += bytes([27, ord("x")])  # M-x (ESC x)
    data2 += b"save-buffer\n"
    data2 += bytes([27, ord("x")])  # M-x (ESC x)
    data2 += bytes([27, ord("p")])  # M-p (history prev)
    data2 += b"\n"
    # Keyboard macro surface: M-x execute-kbd-macro twice (define + replay).
    data2 += bytes([27, ord("x")])  # M-x (ESC x)
    data2 += b"execute-kbd-macro\n"
    data2 += b"C-a C-e\n"
    data2 += bytes([27, ord("x")])  # M-x (ESC x)
    data2 += b"execute-kbd-macro\n"
    data2 += b"C-a C-e\n"
    # Crash shield gate: an unknown command error returns to the loop.
    data2 += bytes([27, ord("x")])  # M-x (ESC x)
    data2 += b"clemacs-definitely-not-a-command\n"
    # Basic multi-window surface: split/other/delete.
    data2 += bytes([24, 50])  # C-x 2 (split-window-below)
    data2 += bytes([24, ord("o")])  # C-x o (other-window)
    data2 += bytes([24, 48])  # C-x 0 (delete-window)
    data2 += bytes([27, ord("x")])  # M-x (ESC x)
    data2 += b"save-buffers-kill-terminal\n"

    out2 = run_pty(
        level="tty-editor",
        tty_path="",
        data=bytes(data2),
        expect_file_bytes=None,
    )
    # `save-buffer` should have written OUTFILE.
    content = open(outfile2, "rb").read()
    if content != b"abX\nLINE2c":
        sys.stderr.write(out2.decode("utf-8", "replace"))
        sys.stderr.write("tty-editor unexpected file contents: %r\n" % (content,))
        raise SystemExit(1)
finally:
    try:
        os.unlink(outfile2)
    except OSError:
        pass

print("clemacs tty: ok")
PY
