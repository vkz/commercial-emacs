#!/usr/bin/env bash
set -eEuo pipefail

#MISE description="Run clemacs contract gate (successor to Emacs test:smoke for clemacs)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--level <level>" help="Contract level: smoke|elisp-core|check" default="smoke"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"
#USAGE flag "--skip-tty" help="Skip the clemacs:test:tty task (useful when running it separately)" default="false"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

level="${usage_level}"
build_dir="${usage_build_dir}"
skip_tty="${usage_skip_tty:-false}"
mkdir -p "${build_dir}"

stamp_dir="${project_root}/${build_dir}/stamps"
mkdir -p "${stamp_dir}"
ok_stamp="${stamp_dir}/clemacs-contract-${level}.ok"
fail_stamp="${stamp_dir}/clemacs-contract-${level}.fail"
now_utc="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
git_rev="$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
cur_task=""

on_err() {
  local exit_code=$?
  local now_utc_fail
  now_utc_fail="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  {
    echo "status=fail"
    echo "when=${now_utc_fail}"
    echo "git=${git_rev}"
    echo "level=${level}"
    echo "build_dir=${build_dir}"
    echo "task=${cur_task:-unknown}"
  } >"${fail_stamp}"
  exit "${exit_code}"
}
trap on_err ERR

contract_dir="${project_root}/clemacs/contract"
case "${level}" in
  smoke) manifest="${contract_dir}/smoke.tasks" ;;
  elisp-core) manifest="${contract_dir}/elisp-core.tasks" ;;
  check) manifest="${contract_dir}/check.tasks" ;;
  *)
    echo "[clemacs:test:contract] unknown level: ${level}" >&2
    exit 2
    ;;
esac

if [[ ! -f "${manifest}" ]]; then
  echo "[clemacs:test:contract] missing manifest: ${manifest}" >&2
  exit 2
fi

while IFS= read -r task; do
  [[ -z "${task}" ]] && continue
  [[ "${task}" =~ ^# ]] && continue
  if [[ "${skip_tty}" == "true" && "${task}" == "clemacs:test:tty" ]]; then
    continue
  fi
  cur_task="${task}"
  mise run "${task}" -- --build-dir "${build_dir}"
done < "${manifest}"

{
  echo "status=ok"
  echo "when=${now_utc}"
  echo "git=${git_rev}"
  echo "level=${level}"
  echo "build_dir=${build_dir}"
  echo "manifest=${manifest}"
} >"${ok_stamp}"

rm -f "${fail_stamp}" 2>/dev/null || true
