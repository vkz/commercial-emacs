#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run a minimal upstream ERT bring-up gate under clemacs (experimental)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

export XDG_CACHE_HOME="${project_root}/${build_dir}/xdg-cache"
export XDG_CONFIG_HOME="${project_root}/${build_dir}/xdg-config"
export XDG_DATA_HOME="${project_root}/${build_dir}/xdg-data"

home_dir="${project_root}/${build_dir}/home"
mkdir -p "${home_dir}"
export HOME="${home_dir}"

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
sbcl_dynamic_space="${CLEMACS_SBCL_DYNAMIC_SPACE_SIZE:-4096}"

bootstrap_eval="nil"
f="${project_root}/clemacs/contract/bootstrap.maxforms"
if [[ -f "${f}" ]]; then
  v="$(tr -d ' \t\r\n' < "${f}")"
  if [[ "${v}" =~ ^[0-9]+$ ]]; then
    bootstrap_eval="${v}"
  fi
fi

ert_eval="nil"
f="${project_root}/clemacs/contract/ert.maxforms"
[[ -f "${f}" ]] && ert_eval="$(tr -d ' \t\r\n' < "${f}")"

tests_eval="nil"
f="${project_root}/clemacs/contract/ert-tests.maxforms"
[[ -f "${f}" ]] && tests_eval="$(tr -d ' \t\r\n' < "${f}")"

tests_manifest="${project_root}/clemacs/contract/ert-upstream.tests"
known_fail_manifest="${project_root}/clemacs/contract/ert-upstream.known-fail.tests"

names_lisp="(list"
if [[ -f "${tests_manifest}" ]]; then
  while IFS= read -r line; do
    line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    if [[ -z "${line}" ]]; then
      continue
    fi
    if [[ "${line}" == \#* ]]; then
      continue
    fi
    line="${line%%#*}"
    line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    if [[ -n "${line}" ]]; then
      esc="${line//\"/\\\"}"
      names_lisp="${names_lisp} \"${esc}\""
    fi
  done < "${tests_manifest}"
fi
names_lisp="${names_lisp})"
if [[ "${names_lisp}" == "(list)" ]]; then
  names_lisp='(list "ert-test-body-runs")'
fi

known_fail_lisp="(list"
if [[ -f "${known_fail_manifest}" ]]; then
  while IFS= read -r line; do
    line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    if [[ -z "${line}" ]]; then
      continue
    fi
    if [[ "${line}" == \#* ]]; then
      continue
    fi
    line="${line%%#*}"
    line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    if [[ -n "${line}" ]]; then
      esc="${line//\"/\\\"}"
      known_fail_lisp="${known_fail_lisp} \"${esc}\""
    fi
  done < "${known_fail_manifest}"
fi
known_fail_lisp="${known_fail_lisp})"

cd "${deps_dir}"
"${qlot_bin}" exec sbcl \
  --dynamic-space-size "${sbcl_dynamic_space}" \
  --noinform \
  --no-sysinit \
  --no-userinit \
  --non-interactive \
  --disable-debugger \
  --eval '(require :asdf)' \
  --eval "(asdf:load-asd #p\"${project_root}/clemacs/clemacs.asd\")" \
  --eval '(asdf:load-system :clemacs)' \
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/emacs-lisp/backquote.el\")" \
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/subr.el\" :max-forms ${bootstrap_eval})" \
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/emacs-lisp/ert.el\" :max-forms ${ert_eval})" \
  --eval "(elisp:load-elisp-file #p\"${project_root}/test/lisp/emacs-lisp/ert-tests.el\" :max-forms ${tests_eval})" \
  --eval "(uiop:quit (clemacs:run-upstream-ert-tests :names ${names_lisp} :known-fail ${known_fail_lisp}))"
