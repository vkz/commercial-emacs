#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run one upstream ERT test by name under clemacs (triage helper)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--debug-condition-case" help="Set CLEMACS_DEBUG_CONDITION_CASE=1 (prints CL backtrace at condition-case boundary)"
#USAGE flag "--use-known-fail" help="Treat tests listed in ert-upstream.known-fail.tests as XFAIL (matches the gate behavior)"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"
#USAGE arg "[tests]" var=#true hide=#true

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

if [[ "${usage_debug_condition_case:-false}" == "true" ]]; then
  export CLEMACS_DEBUG_CONDITION_CASE=1
fi

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

source "${project_root}/.mise/tasks/clemacs/lib/sbcl.sh"
clemacs_setup_xdg_and_home "${project_root}" "${build_dir}"

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
sbcl_dynamic_space="${CLEMACS_SBCL_DYNAMIC_SPACE_SIZE:-4096}"

bootstrap_eval="nil"
f="${project_root}/clemacs/contract/bootstrap.maxforms"
if [[ -f "${f}" ]]; then
  v="$(tr -d ' \t\r\n' < "${f}")"
  if [[ "${v}" =~ ^[0-9]+$ ]]; then
    bootstrap_eval="${v}"
  fi
fi

ert_eval="nil"
f="${project_root}/clemacs/contract/ert.maxforms"
[[ -f "${f}" ]] && ert_eval="$(tr -d ' \t\r\n' < "${f}")"

tests_eval="nil"
f="${project_root}/clemacs/contract/ert-tests.maxforms"
[[ -f "${f}" ]] && tests_eval="$(tr -d ' \t\r\n' < "${f}")"

ert_x_tests_eval="nil"
f="${project_root}/clemacs/contract/ert-x-tests.maxforms"
[[ -f "${f}" ]] && ert_x_tests_eval="$(tr -d ' \t\r\n' < "${f}")"

load_manifest="${project_root}/clemacs/contract/ert-upstream.load.files"

if [[ "$#" -lt 1 ]]; then
  echo "[clemacs:test:ert-upstream-one] missing <test-name>" >&2
  echo "[clemacs:test:ert-upstream-one] usage: mise run clemacs:test:ert-upstream-one -- <test-name> [more-tests...]" >&2
  exit 2
fi

names_lisp="(list"
for raw in "$@"; do
  if [[ "${raw}" == -* ]]; then
    continue
  fi
  name="${raw%%#*}"
  name="$(printf "%s" "${name}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
  if [[ -n "${name}" ]]; then
    esc="${name//\"/\\\"}"
    names_lisp="${names_lisp} \"${esc}\""
  fi
done
names_lisp="${names_lisp})"

known_fail_lisp="nil"
if [[ "${usage_use_known_fail:-false}" == "true" ]]; then
  known_fail_manifest="${project_root}/clemacs/contract/ert-upstream.known-fail.tests"
  known_fail_lisp="(list"
  if [[ -f "${known_fail_manifest}" ]]; then
    while IFS= read -r line; do
      line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
      if [[ -z "${line}" ]]; then
        continue
      fi
      if [[ "${line}" == \#* ]]; then
        continue
      fi
      line="${line%%#*}"
      line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
      if [[ -n "${line}" ]]; then
        esc="${line//\"/\\\"}"
        known_fail_lisp="${known_fail_lisp} \"${esc}\""
      fi
    done < "${known_fail_manifest}"
  fi
  known_fail_lisp="${known_fail_lisp})"
fi

extra_eval_args=()
if [[ -f "${load_manifest}" ]]; then
  while IFS= read -r line; do
    line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    [[ -z "${line}" ]] && continue
    [[ "${line}" == \#* ]] && continue
    line="${line%%#*}"
    line="$(printf "%s" "${line}" | sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//')"
    [[ -z "${line}" ]] && continue

    set -- ${line}
    rel_path="${1:-}"
    max_forms="${2:-}"
    if [[ -z "${rel_path}" ]]; then
      continue
    fi
    if [[ -n "${3:-}" ]]; then
      echo "[clemacs:test:ert-upstream-one] bad load entry (too many fields): ${line}" >&2
      exit 2
    fi

    max_forms_eval="nil"
    if [[ -n "${max_forms}" && "${max_forms}" != "-" ]]; then
      if [[ "${max_forms}" =~ ^[0-9]+$ ]]; then
        max_forms_eval="${max_forms}"
      else
        echo "[clemacs:test:ert-upstream-one] bad max-forms: ${max_forms} (${line})" >&2
        exit 2
      fi
    fi

    extra_eval_args+=(--eval "(elisp:load-elisp-file #p\"${project_root}/${rel_path}\" :max-forms ${max_forms_eval})")
  done < "${load_manifest}"
fi

eval_args=(
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/emacs-lisp/backquote.el\")"
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/subr.el\" :max-forms ${bootstrap_eval})"
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/emacs-lisp/pp.el\")"
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/emacs-lisp/ert.el\" :max-forms ${ert_eval})"
  --eval "(elisp:load-elisp-file #p\"${project_root}/lisp/emacs-lisp/ert-x.el\")"
  --eval "(elisp:load-elisp-file #p\"${project_root}/test/lisp/emacs-lisp/ert-tests.el\" :max-forms ${tests_eval})"
  --eval "(elisp:load-elisp-file #p\"${project_root}/test/lisp/emacs-lisp/ert-x-tests.el\" :max-forms ${ert_x_tests_eval})"
)

if [[ "${#extra_eval_args[@]}" != "0" ]]; then
  eval_args+=("${extra_eval_args[@]}")
fi

eval_args+=(--eval "(uiop:quit (clemacs:run-upstream-ert-tests :names ${names_lisp} :known-fail ${known_fail_lisp}))")

clemacs_sbcl_eval \
  "${project_root}" \
  "${build_dir}" \
  "${deps_dir}" \
  "${qlot_bin}" \
  "${sbcl_dynamic_space}" \
  "${eval_args[@]}"
