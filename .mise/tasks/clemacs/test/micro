#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run clemacs ELisp semantics microtests only (fastest loop)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--no-emacs" help="Skip reference Emacs comparisons (faster)" default="false"
#USAGE flag "--name <name>" help="Run only semantics microtests whose :name contains this substring (or comma-separated substrings). Equivalent to CLEMACS_MICROTEST_NAME." default=""
#USAGE flag "--limit <n>" help="Run only the first N semantics microtests after filtering. Equivalent to CLEMACS_MICROTEST_LIMIT." default=""
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

source "${project_root}/.mise/tasks/clemacs/lib/sbcl.sh"
source "${project_root}/.mise/tasks/clemacs/lib/reference-emacs.sh"
clemacs_setup_xdg_and_home "${project_root}" "${build_dir}"

if [[ "${usage_no_emacs:-false}" == "true" ]]; then
  export CLEMACS_SKIP_REFERENCE_EMACS=1
else
  clemacs_export_reference_emacs_if_unset
  if [[ -n "${CLEMACS_REFERENCE_EMACS:-}" ]]; then
    echo "[clemacs] reference emacs: ${CLEMACS_REFERENCE_EMACS}" >&2
  else
    echo "[clemacs] reference emacs: <none> (set CLEMACS_REFERENCE_EMACS or pass --no-emacs)" >&2
  fi
fi

if [[ -n "${usage_name:-}" ]]; then
  export CLEMACS_MICROTEST_NAME="${usage_name}"
fi

if [[ -n "${usage_limit:-}" ]]; then
  export CLEMACS_MICROTEST_LIMIT="${usage_limit}"
fi

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"
usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/substrate/build"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
substrate_dylib="${project_root}/${build_dir}/substrate/libemxsubstrate.dylib"
sbcl_dynamic_space="${CLEMACS_SBCL_DYNAMIC_SPACE_SIZE:-4096}"

export CLEMACS_SUBSTRATE_DYLIB="${substrate_dylib}"

clemacs_sbcl_eval \
  "${project_root}" \
  "${build_dir}" \
  "${deps_dir}" \
  "${qlot_bin}" \
  "${sbcl_dynamic_space}" \
  --eval '(uiop:quit (clemacs.test:run-micro))'
