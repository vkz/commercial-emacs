#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run clemacs smoke tests (CL-level, fast)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

source "${project_root}/.mise/tasks/clemacs/lib/sbcl.sh"
clemacs_setup_xdg_and_home "${project_root}" "${build_dir}"

if [[ -z "${CLEMACS_REFERENCE_EMACS:-}" ]]; then
  if [[ -x "/opt/homebrew/bin/emacs" ]]; then
    export CLEMACS_REFERENCE_EMACS="/opt/homebrew/bin/emacs"
  elif [[ -x "/usr/local/bin/emacs" ]]; then
    export CLEMACS_REFERENCE_EMACS="/usr/local/bin/emacs"
  elif command -v emacs >/dev/null 2>&1; then
    export CLEMACS_REFERENCE_EMACS="$(command -v emacs)"
  fi
fi

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"
usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/substrate/build"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
substrate_dylib="${project_root}/${build_dir}/substrate/libemxsubstrate.dylib"
sbcl_dynamic_space="${CLEMACS_SBCL_DYNAMIC_SPACE_SIZE:-4096}"

export CLEMACS_SUBSTRATE_DYLIB="${substrate_dylib}"

clemacs_sbcl_eval \
  "${project_root}" \
  "${build_dir}" \
  "${deps_dir}" \
  "${qlot_bin}" \
  "${sbcl_dynamic_space}" \
  --eval '(uiop:quit (clemacs.test:run-smoke))'
