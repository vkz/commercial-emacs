#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run clemacs smoke tests (CL-level, fast)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

export XDG_CACHE_HOME="${project_root}/${build_dir}/xdg-cache"
export XDG_CONFIG_HOME="${project_root}/${build_dir}/xdg-config"
export XDG_DATA_HOME="${project_root}/${build_dir}/xdg-data"

home_dir="${project_root}/${build_dir}/home"
mkdir -p "${home_dir}"
export HOME="${home_dir}"

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"
usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/substrate/build"

substrate_dylib="${project_root}/${build_dir}/substrate/libemxsubstrate.dylib"
core_path="${project_root}/${build_dir}/clemacs.core"
sbcl_dynamic_space="${CLEMACS_SBCL_DYNAMIC_SPACE_SIZE:-4096}"

export CLEMACS_SUBSTRATE_DYLIB="${substrate_dylib}"

core_fresh=false
if [[ -f "${core_path}" ]]; then
  if ! find "${project_root}/clemacs" \
      -type f \
      \( -name '*.lisp' -o -name '*.asd' -o -name 'qlfile' -o -name 'qlfile.lock' \) \
      -newer "${core_path}" \
      -print -quit | rg -q .; then
    core_fresh=true
  fi
fi

if [[ "${core_fresh}" == "true" ]]; then
  mise x -- sbcl \
    --dynamic-space-size "${sbcl_dynamic_space}" \
    --core "${core_path}" \
    --noinform \
    --disable-debugger \
    --no-sysinit \
    --no-userinit \
    --non-interactive \
    --eval '(sb-ext:exit :code (clemacs.test:run-smoke))'
else
  deps_dir="${project_root}/${build_dir}/deps"
  qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"

  cd "${deps_dir}"
  "${qlot_bin}" exec sbcl \
    --dynamic-space-size "${sbcl_dynamic_space}" \
    --noinform \
    --no-sysinit \
    --no-userinit \
    --non-interactive \
    --disable-debugger \
    --eval '(require :asdf)' \
    --eval "(asdf:load-asd #p\"${project_root}/clemacs/clemacs.asd\")" \
    --eval '(asdf:load-system :clemacs)' \
    --eval '(uiop:quit (clemacs.test:run-smoke))'
fi
