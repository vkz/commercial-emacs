#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run clemacs interactive TTY loop (experimental)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"
#USAGE arg "[file]" help="Optional file to edit (default: in-memory buffer)"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

source "${project_root}/.mise/tasks/clemacs/lib/sbcl.sh"
clemacs_setup_xdg_and_home "${project_root}" "${build_dir}"

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"
usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/substrate/build"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
substrate_dylib="${project_root}/${build_dir}/substrate/libemxsubstrate.dylib"
core_path="${project_root}/${build_dir}/clemacs.core"
sbcl_dynamic_space="${CLEMACS_SBCL_DYNAMIC_SPACE_SIZE:-4096}"

export CLEMACS_SUBSTRATE_DYLIB="${substrate_dylib}"

if [[ -n "${1:-}" ]]; then
  export CLEMACS_TTY_PATH="${1}"
else
  unset CLEMACS_TTY_PATH || true
fi

stty_state="$(stty -g 2>/dev/null || true)"
cleanup() {
  if [[ -n "${stty_state}" ]]; then
    stty "${stty_state}" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

clemacs_ensure_core "${project_root}" "${build_dir}" "${core_path}"

common_args=(
  --dynamic-space-size "${sbcl_dynamic_space}"
  --noinform
  --no-sysinit
  --no-userinit
  --disable-debugger
  --eval '(declaim (sb-ext:muffle-conditions style-warning sb-ext:compiler-note))'
  --eval '(setf *compile-verbose* nil *load-verbose* nil)'
)

use_core="${CLEMACS_USE_CORE:-1}"
if [[ "${use_core}" != "0" && -f "${core_path}" ]]; then
  sbcl --core "${core_path}" "${common_args[@]}" \
    --eval '(uiop:quit (clemacs:tty-main :path (uiop:getenv "CLEMACS_TTY_PATH")))'
else
  cd "${deps_dir}"
  "${qlot_bin}" exec sbcl \
    "${common_args[@]}" \
    --eval '(require :asdf)' \
    --eval "(asdf:load-asd #p\"${project_root}/clemacs/clemacs.asd\")" \
    --eval '(asdf:load-system :clemacs)' \
    --eval '(uiop:quit (clemacs:tty-main :path (uiop:getenv "CLEMACS_TTY_PATH")))'
fi
