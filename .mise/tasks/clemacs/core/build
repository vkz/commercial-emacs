#!/usr/bin/env bash
set -euo pipefail

#MISE description="Build an SBCL core for faster clemacs startup"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

export XDG_CACHE_HOME="${project_root}/${build_dir}/xdg-cache"

mise run clemacs:deps:install -- --build-dir "${build_dir}"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
core_path="${project_root}/${build_dir}/clemacs.core"

cd "${deps_dir}"
"${qlot_bin}" exec sbcl \
  --noinform \
  --no-sysinit \
  --no-userinit \
  --non-interactive \
  --disable-debugger \
  --eval '(require :asdf)' \
  --eval "(asdf:load-asd #p\"${project_root}/clemacs/clemacs.asd\")" \
  --eval '(asdf:load-system :clemacs)' \
  --eval "(sb-ext:save-lisp-and-die \"${core_path}\" :executable nil :compression t)"

echo "[clemacs:core:build] wrote ${core_path}"
