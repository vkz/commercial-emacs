#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run clemacs using a saved SBCL core (requires clemacs:core:build)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"
#USAGE arg "[args]" var=#true hide=#true

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
core_path="${project_root}/${build_dir}/clemacs.core"

if [[ ! -f "${core_path}" ]]; then
  mise run clemacs:core:build -- --build-dir "${build_dir}"
fi

export XDG_CACHE_HOME="${project_root}/${build_dir}/xdg-cache"

mise x -- sbcl \
  --core "${core_path}" \
  --noinform \
  --no-sysinit \
  --no-userinit \
  --disable-debugger \
  --eval '(sb-ext:exit :code (clemacs:main))'
