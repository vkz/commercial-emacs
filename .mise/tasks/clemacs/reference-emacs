#!/usr/bin/env bash
set -euo pipefail

#MISE description="Print/check the reference Emacs used for :emacs :match microtests"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--check" help="Exit nonzero if the resolved Emacs cannot run batch evals"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

source "${project_root}/.mise/tasks/clemacs/lib/reference-emacs.sh"
raw="${CLEMACS_REFERENCE_EMACS:-}"
resolved="$(clemacs_resolve_reference_emacs 2>/dev/null || true)"
if [[ -n "${raw}" ]]; then
  source="CLEMACS_REFERENCE_EMACS"
elif [[ -n "${resolved}" && "${resolved}" == "/opt/homebrew/bin/emacs" ]]; then
  source="/opt/homebrew/bin/emacs"
elif [[ -n "${resolved}" && "${resolved}" == "/usr/local/bin/emacs" ]]; then
  source="/usr/local/bin/emacs"
elif [[ -n "${resolved}" ]]; then
  source="PATH"
else
  source="unavailable"
fi

echo "CLEMACS_REFERENCE_EMACS=${raw:-<unset>}"
echo "Resolved reference Emacs (${source}): ${resolved:-<none>}"
echo "Note: :emacs :match microtests run '${resolved} -Q --batch -l <tmp>.el' (not gxeval); microtests batch all :match exprs per run (set CLEMACS_REFERENCE_EMACS_BATCH=0 to disable)."
echo "Note: ad-hoc eval without shell escaping: mise run clemacs:ref-emacs:eval <<'EL' ... EL"
echo "Note: interactive probing uses: gxeval -s wip -e '(...)'"

if [[ "${usage_check:-false}" != "true" ]]; then
  exit 0
fi

if [[ -z "${resolved}" ]]; then
  echo "[clemacs:reference-emacs] FAIL: emacs not found (set CLEMACS_REFERENCE_EMACS or put emacs on PATH)" >&2
  exit 2
fi
if [[ ! -x "${resolved}" ]]; then
  echo "[clemacs:reference-emacs] FAIL: not executable: ${resolved}" >&2
  exit 2
fi

"${resolved}" -Q --batch --eval '(princ (format "ok emacs=%s" emacs-version))' >/dev/null
echo "[clemacs:reference-emacs] ok"
