#!/usr/bin/env bash
set -euo pipefail

#MISE description="Measure clemacs cold start time (clears clemacs xdg-cache)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"
cache_dir="${project_root}/${build_dir}/xdg-cache"

rm -rf "${cache_dir}"

echo "[clemacs:bench:cold] cleared ${cache_dir}"
/usr/bin/time -p mise run clemacs:run -- --build-dir "${build_dir}" >/dev/null
