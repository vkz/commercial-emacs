#!/usr/bin/env bash
set -euo pipefail

#MISE description="Load a clemacs lisp manifest under SBCL (experimental)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--level <level>" help="Manifest level: smoke|check" default="smoke"
#USAGE flag "--build-dir <dir>" help="Out-of-tree clemacs build directory" default="build/clemacs"
#USAGE flag "--limit <n>" help="Load only the first N manifest entries" default="0"
#USAGE flag "--max-forms <n>" help="Stop after N forms in each loaded file (0 = no limit)" default="0"

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

level="${usage_level}"
build_dir="${usage_build_dir}"
mkdir -p "${build_dir}"

source "${project_root}/.mise/tasks/clemacs/lib/sbcl.sh"
clemacs_setup_xdg_and_home "${project_root}" "${build_dir}"

usage_build_dir="${build_dir}" bash "${project_root}/.mise/tasks/clemacs/deps/install"

deps_dir="${project_root}/${build_dir}/deps"
qlot_bin="${project_root}/${build_dir}/tools/qlot/bin/qlot"
sbcl_dynamic_space="${CLEMACS_SBCL_DYNAMIC_SPACE_SIZE:-4096}"
limit="${usage_limit}"
max_forms="${usage_max_forms}"

manifest_rel="clemacs/contract/lisp.${level}.files"
case "${level}" in
  smoke|check) ;;
  *)
    echo "[clemacs:load:lisp] unknown level: ${level}" >&2
    exit 2
    ;;
esac

manifest_path="${project_root}/${manifest_rel}"
if [[ ! -f "${manifest_path}" ]]; then
  echo "[clemacs:load:lisp] missing manifest: ${manifest_path}" >&2
  exit 2
fi

skip_rel="clemacs/contract/lisp.allowed-skip.files"

max_forms_eval="nil"
if [[ "${max_forms}" != "0" ]]; then
  max_forms_eval="${max_forms}"
fi

limit_eval="nil"
if [[ "${limit}" != "0" ]]; then
  limit_eval="${limit}"
fi

clemacs_sbcl_eval \
  "${project_root}" \
  "${build_dir}" \
  "${deps_dir}" \
  "${qlot_bin}" \
  "${sbcl_dynamic_space}" \
  --eval "(uiop:quit (elisp:load-elisp-manifest :project-root #p\"${project_root}/\" :manifest #p\"${manifest_rel}\" :skip-file #p\"${skip_rel}\" :limit ${limit_eval} :max-forms ${max_forms_eval}))"
