#!/usr/bin/env bash
set -euo pipefail

#MISE description="Build clmacs (TTY-only) in the configured build directory (no manuals)"
#USAGE flag "-h --help" help="Print help"
#USAGE flag "--build-dir <dir>" help="Out-of-tree build directory" default="build/macos-tty"
#USAGE flag "-j --jobs <n>" help="make -j jobs (default: cpu count)" default=""

if [[ "${usage_help:-false}" == "true" ]]; then
  mise tasks info "${MISE_TASK_NAME}"
  exit 0
fi

project_root="${MISE_PROJECT_ROOT:-$(pwd)}"
cd "${project_root}"

build_dir="${usage_build_dir}"

if [[ ! -f "${build_dir}/Makefile" ]]; then
  mise run configure:tty -- --build-dir "${build_dir}"
fi

jobs="${usage_jobs:-}"
if [[ -z "${jobs}" ]]; then
  jobs="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)"
fi

ensure_symlink_tree() {
  local src_dir="$1"
  local dst_dir="$2"

  mkdir -p "${dst_dir}"
  for src in "${src_dir}/"*; do
    local base
    base="$(basename "${src}")"
    if [[ "${base}" == "Makefile" ]]; then
      continue
    fi
    if [[ ! -e "${dst_dir}/${base}" ]]; then
      ln -s "${src}" "${dst_dir}/${base}"
    fi
  done
}

echo "[build] building in ${build_dir} (-j${jobs})"
mkdir -p "${build_dir}/lib/bitset"

# Out-of-tree builds in this repo expect to find (some) architecture-
# independent runtime files in the build tree by relative paths.
ensure_symlink_tree "${project_root}/etc" "${build_dir}/etc"
ensure_symlink_tree "${project_root}/lisp" "${build_dir}/lisp"
ensure_symlink_tree "${project_root}/leim" "${build_dir}/leim"
ensure_symlink_tree "${project_root}/admin" "${build_dir}/admin"
ensure_symlink_tree "${project_root}/admin/charsets" "${build_dir}/admin/charsets"

# `src/emacs` still expects a `loaddefs.el` file in the source tree during
# build-time batch invocations (e.g. `src/Makefile`'s relative-lisp-files
# plumbing), but we intentionally avoid requiring `make -C lisp autoloads`
# to succeed in a fresh checkout.
#
# Use the checked-in snapshot `ldefs-boot.el` as the default `loaddefs.el`.
if [[ ! -f "${project_root}/lisp/loaddefs.el" ]]; then
  cp -f "${project_root}/lisp/ldefs-boot.el" "${project_root}/lisp/loaddefs.el"
fi

make -C "${build_dir}" -j"${jobs}" src

# Some test suites (notably package tests) expect shipped snapshot files
# to exist in the source lisp tree.
#
# In an out-of-tree build, `lisp/Makefile` writes these snapshots into
# `$(srcdir)`, so we generate them once if missing and then refresh the
# symlink tree so the build dir sees them too.
if [[ ! -f "${project_root}/lisp/cus-load.el" || ! -f "${project_root}/lisp/finder-inf.el" ]]; then
  make -C "${build_dir}/lisp" -j"${jobs}" ./cus-load.el ./finder-inf.el
  ensure_symlink_tree "${project_root}/lisp" "${build_dir}/lisp"
fi
